# Copiar a .env y rellenar (nunca versionar .env)
#
# Variables opcionales del TFG. El pipeline principal no requiere ninguna.

# Monitor Telegram (scripts/monitor/ — solo uso interno, no incluido en release publica)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Plataforma web de experimentos (scripts/experiments_db/ — solo uso interno)
# WEB_AUTH_TOKEN=
# WEB_HOST=127.0.0.1
# WEB_PORT=8787
